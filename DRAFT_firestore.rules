rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Definitions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check with bootstrapped email and verified check
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email_verified == true && 
             (request.auth.token.email == 'salwanettayumna@gmail.com' || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')); 
    }

    // 2. User Profile Validation
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 255 &&
             data.role in ['free', 'premium', 'admin'] &&
             (data.displayName is string || !('displayName' in data)) &&
             (data.gpa is number || !('gpa' in data)) &&
             (data.matchCount is int || !('matchCount' in data));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      // Only isOwner can list, but we usually don't list users. 
      // If we do, we must filter by UID.
      allow list: if isOwner(userId) || isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == 'free' &&
                      incoming().matchCount == 0;
      
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || (
          isOwner(userId) && 
          incoming().role == existing().role && (
            // Action: Edit Profile
            (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'gpa', 'field', 'country', 'language'])) ||
            // Action: AI Matching (increment count)
            (incoming().diff(existing()).affectedKeys().hasOnly(['matchCount']) && incoming().matchCount == existing().matchCount + 1)
          )
        )
      );
    }

    // 3. Scholarship Management (Hardened)
    function isValidScholarship(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.deadline is string && data.deadline.size() <= 50;
    }

    match /scholarships/{scholarshipId} {
      // Made public for visitor access
      allow read: if true; 
      allow write: if isAdmin() && isValidScholarship(incoming());
    }

    // 4. Personal Roadmaps
    match /roadmaps/{roadmapId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidId(roadmapId);
      allow update: if isOwner(existing().userId) && 
                      incoming().userId == existing().userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['steps']);
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // 5. Notifications (PII Isolated)
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(existing().userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // 6. Forum (Moderated)
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(incoming().userId) && 
                      incoming().content is string && incoming().content.size() <= 2000;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
  }
}
