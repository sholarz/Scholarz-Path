{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "strict": false,
        "baseUrl": ".",
        "types": ["vite/client", "vitest/globals"],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*", "src/**/*.d.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
